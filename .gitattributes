# Auto detect text files and perform LF normalization
* text=auto
*.tif filter=lfs diff=lfs merge=lfs -text
*.hdf filter=lfs diff=lfs merge=lfs -text
*.dss filter=lfs diff=lfs merge=lfs -text

# ---- Added for the HEC-HMS build (see README.md) ----
# Binary GIS / model outputs generated by scripts/ and by HEC-HMS runs
*.gpkg filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
GIS/**/*.shp filter=lfs diff=lfs merge=lfs -text
GIS/**/*.dbf filter=lfs diff=lfs merge=lfs -text
GIS/**/*.shx filter=lfs diff=lfs merge=lfs -text
HMS/**/*.shp filter=lfs diff=lfs merge=lfs -text
HMS/**/*.dbf filter=lfs diff=lfs merge=lfs -text
HMS/**/*.shx filter=lfs diff=lfs merge=lfs -text
HMS/**/*.out filter=lfs diff=lfs merge=lfs -text
# HEC-HMS text files keep Windows line endings
*.hms text eol=crlf
*.basin text eol=crlf
*.met text eol=crlf
*.control text eol=crlf
*.gage text eol=crlf
*.run text eol=crlf
*.pdata text eol=crlf
*.gdr text eol=crlf
